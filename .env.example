COMPOSE_PROJECT_NAME=tesis-ingestion

# ── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_USER=benchmark
POSTGRES_PASSWORD=benchmark
POSTGRES_DB=benchmark
POSTGRES_PORT=5432

# ── Kafka ───────────────────────────────────────────────────────────
KAFKA_BROKER_ID=1
KAFKA_PORT=9092
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
# Increased partitions to support higher parallelism at extreme-load
KAFKA_NUM_PARTITIONS=12
KAFKA_REPLICATION_FACTOR=1

# ── Spark ───────────────────────────────────────────────────────────
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080
# Increased from 2→4 cores and 1G→2G for large-scale experiments
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=2G

# ── Flink ───────────────────────────────────────────────────────────
# Increased task slots to match Spark parallelism
FLINK_PARALLELISM=4
FLINK_TASKMANAGER_MEMORY=2048m

# ── Prometheus ──────────────────────────────────────────────────────
# Intervalo de scrape de métricas (Prometheus + cAdvisor)
PROMETHEUS_SCRAPE_INTERVAL=5s

# ── Generator ───────────────────────────────────────────────────────
# Scenario options:
#   low-load      — 2,000 ev/s  | schema: iot_sensor
#   medium-load   — 10,000 ev/s | schema: financial_tick
#   high-load     — 30,000 ev/s | schema: health_monitor
#   extreme-load  — 100,000 ev/s| schema: iot_sensor
#   burst         — 10k/50k ev/s burst pattern | schema: financial_tick
#   mixed-payload — 10,000 ev/s, alternating 512B/4KB/64KB payloads
GENERATOR_SCENARIO=low-load
GENERATOR_EVENT_RATE=2000
GENERATOR_PAYLOAD_BYTES=512

# Optional: override the event schema regardless of scenario
# Options: iot_sensor | financial_tick | health_monitor
# GENERATOR_EVENT_SCHEMA=iot_sensor

# 0 = infinite; set to duration in seconds for automated runs (e.g. 1800 = 30 min)
GENERATOR_RUN_DURATION_SECONDS=0

# Warmup period (seconds) — data produced here is excluded from analysis
GENERATOR_WARMUP_SECONDS=30

# ── Probe ────────────────────────────────────────────────────────────
PROBE_POLL_INTERVAL_MS=500

# ══════════════════════════════════════════════════════════════════
# Execution mode and distributed mode variables (AWS)
# ══════════════════════════════════════════════════════════════════

# Execution mode:
#   local       = everything via Docker Compose on this machine (default)
#   distributed = 4 real AWS VMs managed via IaC
MODE=local

# Kafka bootstrap servers (used by producer and consumers)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── Distributed mode variables (ignored if MODE=local) ─────────
# In distributed mode, Terraform generates infra/terraform/outputs.env
# with actual IPs and exports them as environment variables.
# manage.sh and experiment.sh load them automatically when MODE=distributed.
# DO NOT edit manually — regenerated with each terraform apply.
