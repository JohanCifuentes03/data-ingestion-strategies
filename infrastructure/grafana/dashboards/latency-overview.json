{
  "title": "Latency Overview",
  "uid": "latency-benchmark",
  "version": 1,
  "schemaVersion": 39,
  "editable": true,
  "panels": [
    {
      "type": "timeseries",
      "title": "Availability Latency (p50/p95/p99)",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.5, sum(rate(probe_latency_bucket[5m])) by (le))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum(rate(probe_latency_bucket[5m])) by (le))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, sum(rate(probe_latency_bucket[5m])) by (le))", "legendFormat": "p99"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Generator Throughput",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(generator_events_total[1m])", "legendFormat": "events/s"}
      ]
    },
    {
      "type": "timeseries",
      "title": "PostgreSQL Visible Events",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(probe_visible_events_total[1m])", "legendFormat": "events/s"}
      ]
    }
  ]
}
