{
  "title": "Data Ingestion Benchmark",
  "uid": "latency-benchmark",
  "version": 3,
  "schemaVersion": 39,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "strategy",
        "type": "custom",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "batch",
            "value": "batch"
          },
          {
            "text": "microbatch",
            "value": "microbatch"
          },
          {
            "text": "streaming",
            "value": "streaming"
          }
        ],
        "includeAll": true,
        "multi": true,
        "label": "Strategy"
      },
      {
        "name": "scenario",
        "type": "custom",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "low-load",
            "value": "low-load"
          },
          {
            "text": "medium-load",
            "value": "medium-load"
          },
          {
            "text": "high-load",
            "value": "high-load"
          },
          {
            "text": "burst",
            "value": "burst"
          }
        ],
        "includeAll": true,
        "multi": true,
        "label": "Scenario"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Indicadores en Tiempo Real",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Latencia p50",
      "description": "Percentil 50 de latencia de disponibilidad",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1000
              },
              {
                "color": "orange",
                "value": 5000
              },
              {
                "color": "red",
                "value": 15000
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by(le) (increase(probe_latency_bucket{strategy=~\"$strategy\",scenario=~\"$scenario\"}[10m])))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Latencia p95",
      "description": "Percentil 95 de latencia de disponibilidad",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5000
              },
              {
                "color": "orange",
                "value": 15000
              },
              {
                "color": "red",
                "value": 40000
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le) (increase(probe_latency_bucket{strategy=~\"$strategy\",scenario=~\"$scenario\"}[10m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latencia p99",
      "description": "Percentil 99 de latencia de disponibilidad",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10000
              },
              {
                "color": "orange",
                "value": 20000
              },
              {
                "color": "red",
                "value": 40000
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by(le) (increase(probe_latency_bucket{strategy=~\"$strategy\",scenario=~\"$scenario\"}[10m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Eventos Visibles (total)",
      "description": "Total de eventos observados en PostgreSQL",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(probe_visible_events_total{strategy=~\"$strategy\",scenario=~\"$scenario\"})",
          "legendFormat": "eventos"
        }
      ]
    },
    {
      "type": "row",
      "title": "Series Temporales — Latencia y Throughput",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latencia de Disponibilidad (p50 / p95 / p99)",
      "description": "Calculado con increase sobre ventana de 2 minutos para adaptarse a estrategias de baja frecuencia (batch)",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 16,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "asc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by(le,strategy,scenario) (increase(probe_latency_bucket{strategy=~\"$strategy\",scenario=~\"$scenario\"}[2m])))",
          "legendFormat": "p50 {{strategy}}/{{scenario}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by(le,strategy,scenario) (increase(probe_latency_bucket{strategy=~\"$strategy\",scenario=~\"$scenario\"}[2m])))",
          "legendFormat": "p95 {{strategy}}/{{scenario}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by(le,strategy,scenario) (increase(probe_latency_bucket{strategy=~\"$strategy\",scenario=~\"$scenario\"}[2m])))",
          "legendFormat": "p99 {{strategy}}/{{scenario}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Warmup Activo",
      "description": "1 = en warmup (no se miden latencias), 0 = corrida valida",
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 40
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "targets": [
        {
          "expr": "generator_warmup_active",
          "legendFormat": "warmup"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Throughput Observado (ev/s)",
      "gridPos": {
        "x": 16,
        "y": 11,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "green",
                "value": 1000
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(probe_throughput_events_per_sec{strategy=~\"$strategy\",scenario=~\"$scenario\"})",
          "legendFormat": "ev/s"
        }
      ]
    },
    {
      "type": "row",
      "title": "Throughput y Recursos del Sistema",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Producer vs Consumer Throughput",
      "description": "Tasa de produccion del generador vs tasa de visibilidad en PostgreSQL",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": true
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "rate(generator_events_total[1m])",
          "legendFormat": "producer (gen)"
        },
        {
          "expr": "sum(rate(probe_visible_events_total{strategy=~\"$strategy\",scenario=~\"$scenario\"}[1m]))",
          "legendFormat": "consumer (probe)"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "CPU por Contenedor",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{name!=\"\"}[1m])",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Memoria por Contenedor",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{name!=\"\"}",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Kafka Consumer Lag",
      "description": "Mensajes pendientes de consumir por consumer group",
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 30,
            "spanNulls": true
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by(consumergroup,topic) (kafka_consumergroup_lag)",
          "legendFormat": "{{consumergroup}} / {{topic}}"
        }
      ]
    }
  ]
}